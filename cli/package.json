{
  "name": "cli",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.8.1 <13"
  },
  "imports": {
    "#cli/*": "./*"
  },
  "scripts": {
    "start": "node index.js start",
    "stop": "node index.js stop",
    "restart": "node index.js restart",
    "status": "node index.js status",
    "logs": "node index.js logs",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9"
  }
}
